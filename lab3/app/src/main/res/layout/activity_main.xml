<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/goal" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ua.maze.MazeView
        android:id="@+id/maze"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/maze_description" />

    <Button
        android:id="@+id/button_up"
        style="@style/MoveButton"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/move_up"
        android:text="@string/arrow_up" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/button_left"
            style="@style/MoveButton"
            android:layout_marginEnd="72dp"
            android:contentDescription="@string/move_left"
            android:text="@string/arrow_left" />

        <Button
            android:id="@+id/button_right"
            style="@style/MoveButton"
            android:contentDescription="@string/move_right"
            android:text="@string/arrow_right" />
    </LinearLayout>

    <Button
        android:id="@+id/button_down"
        style="@style/MoveButton"
        android:contentDescription="@string/move_down"
        android:text="@string/arrow_down" />
</LinearLayout>
